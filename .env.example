# Copy to .env and fill in. Keys are shared person to person, never through git.
ELEVENLABS_API_KEY=
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
HF_TOKEN=

# Aiven for Apache Kafka (free tier): Kafka service > Overview > Connection information
AIVEN_KAFKA_BOOTSTRAP=
AIVEN_KAFKA_CA=certs/aiven/ca.pem
AIVEN_KAFKA_CERT=certs/aiven/service.cert
AIVEN_KAFKA_KEY=certs/aiven/service.key
# Aiven for PostgreSQL (free plan): PostgreSQL service > Overview > Service URI
AIVEN_PG_URI=
